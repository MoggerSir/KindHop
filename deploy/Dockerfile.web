# Web de KinHop (KH-026): build de Vite y Caddy que sirve los estáticos y pasa /api a la API.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
RUN npm ci -w @kindhop/web --no-audit --no-fund --fetch-retries=5 --fetch-retry-maxtimeout=120000 --fetch-timeout=600000
COPY apps/web apps/web
RUN npm run build -w @kindhop/web

FROM caddy:2-alpine
COPY deploy/Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist /srv
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1
