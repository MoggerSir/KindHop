# Copiar a apps/api/.env (nunca subir .env). Sin DATABASE_URL la API de ciudades funciona.
# Sin DATABASE_URL: reports, events, suggestions, pois y transit responden 503 DATABASE_UNAVAILABLE (requireDatabase()).
PORT=3001
WEB_ORIGIN=http://localhost:5173
# DATABASE_URL=postgresql://kindhop:kindhop@localhost:5432/kindhop
# Neon/Supabase suelen traer ?sslmode=require en la URL: pg aplica TLS solo con eso (no hace falta DATABASE_SSL).
# Si la URL no trae sslmode: DATABASE_SSL=true. Verificación de certificado activa por defecto;
# solo con DATABASE_SSL_REJECT_UNAUTHORIZED=false se desactiva (no recomendado).
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=3000
# Token de moderación de incidencias (PATCH, cabecera Authorization: Bearer).
# Sin valor, ese PATCH responde 401. Genera uno largo fuera del repo; no pongas un secreto real aquí.
# REPORTS_ADMIN_TOKEN=