# Copiar a apps/api/.env (nunca subir .env). Sin DATABASE_URL la API de ciudades funciona.
# Sin DATABASE_URL: reports, events, suggestions, pois, districts y el transporte de CDMX responden 503 DATABASE_UNAVAILABLE (requireDatabase()).
# Transporte de Cancún no usa la base: lee en vivo el catálogo público (KH-003, opción A).
# RUTAS_CANCUN_CATALOG_URL=https://rutascancun.com/datos/catalogo.json
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Detrás de un reverse proxy (nginx, Fly, Railway…): cuántos saltos confiar para req.ip (X-Forwarded-For).
# Por defecto no se confía (false). Un proxy delante: TRUST_PROXY=1 o TRUST_PROXY=true.
# TRUST_PROXY=false
# DATABASE_URL=postgresql://kindhop:kindhop@localhost:5432/kindhop
# Neon/Supabase suelen traer ?sslmode=require en la URL: pg aplica TLS solo con eso (no hace falta DATABASE_SSL).
# Si la URL no trae sslmode: DATABASE_SSL=true. Verificación de certificado activa por defecto;
# solo con DATABASE_SSL_REJECT_UNAUTHORIZED=false se desactiva (no recomendado).
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=5
# DATABASE_CONNECTION_TIMEOUT_MS=3000
# Token de moderación de incidencias (PATCH, cabecera Authorization: Bearer).
# Sin valor, ese PATCH responde 401. Genera uno largo fuera del repo; no pongas un secreto real aquí.
# REPORTS_ADMIN_TOKEN=

# --- Autenticación (KH-019, docs/02-modules/auth.md). Obligatorio: sin SESSION_SECRET la API responde 503 a todo. ---
# Origen público de la web (base del redirect de Google y único origen aceptado en escrituras).
PUBLIC_URL=http://localhost:5173
# Firma la cookie de sesión. >= 32 caracteres, aleatorio, distinto por entorno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Google Cloud Console > Credenciales > ID de cliente OAuth (Aplicación web).
# Redirect URI autorizado: <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Entrada "cuenta demo" para desarrollo y la demo. Ignorado si NODE_ENV=production.
# AUTH_DEV_LOGIN=true
# Solo para la demo pública del jurado (KH-026): permite la cuenta demo con NODE_ENV=production.
# AUTH_DEMO_IN_PRODUCTION=true
